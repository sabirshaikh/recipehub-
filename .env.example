# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB (Atlas or local), e.g. mongodb://127.0.0.1:27017/recipehub
MONGODB_URI=

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (optional) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary — https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
